# Example Terraform variables file
# Copy this file to terraform.tfvars and customize the values

# Resource Group Configuration
resource_group_name = "rg-sql-production"
location           = "East US"

# SQL Server Configuration
sql_server_name     = "sql-server-prod-001"
sql_admin_username  = "sqladmin"

# Azure AD Administrator (recommended for production)
azuread_admin_login     = "admin@company.com"
azuread_admin_object_id = "12345678-1234-1234-1234-123456789012"

# SQL Database Configuration
sql_database_name = "myapp-database"
database_sku      = "S1"  # Standard S1 - adjust based on requirements
max_size_gb       = 250
zone_redundant    = false  # Set to true for high availability

# Key Vault Configuration
key_vault_name = "kv-sql-secrets-001"

# Firewall Rules - customize based on your network requirements
allow_azure_services = true
firewall_rules = {
  "office-network" = {
    start_ip = "203.0.113.0"
    end_ip   = "203.0.113.255"
  }
  "development-subnet" = {
    start_ip = "10.0.1.0"
    end_ip   = "10.0.1.255"
  }
}

# Backup Configuration
backup_retention_days = 14
weekly_retention      = "P4W"  # 4 weeks
monthly_retention     = "P12M" # 12 months
yearly_retention      = "P5Y"  # 5 years
week_of_year         = 1

# Security Configuration
enable_auditing              = true
enable_security_alert_policy = true

# Email addresses for security alerts
threat_detection_email_addresses = ["security@company.com"]
security_alert_email_addresses   = ["security@company.com"]

# Storage configuration (you'll need to provide these)
# auditing_storage_endpoint = "https://yourstorageaccount.blob.core.windows.net/"
# auditing_storage_account_key = "your-storage-account-key"
# security_alert_storage_endpoint = "https://yourstorageaccount.blob.core.windows.net/"
# security_alert_storage_account_key = "your-storage-account-key"

# VNet Integration (if required)
# subnet_ids = [
#   "/subscriptions/12345678-1234-1234-1234-123456789012/resourceGroups/rg-network/providers/Microsoft.Network/virtualNetworks/vnet-main/subnets/subnet-database"
# ]

# Tags
tags = {
  Environment   = "Production"
  Project       = "MyApplication"
  Owner         = "DatabaseTeam"
  CostCenter    = "IT-001"
  ManagedBy     = "Terraform"
  BackupPolicy  = "Standard"
  Compliance    = "Required"
}
