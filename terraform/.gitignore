# Local .terraform directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files (may contain sensitive data)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Terraform plan files
*.tfplan
*.tfplan.*

# Lock files (generated by terraform init)
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Environment files
.env
.env.local
.env.*.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backup files
*.backup
*.bak
*.tmp

# Log files
*.log

# Archive files
*.zip
*.tar.gz
*.rar
